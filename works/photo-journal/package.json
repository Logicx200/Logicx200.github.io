{
  "name": "photo-journal",
  "version": "0.1.0",
  "private": true,
  "description": "摄影记录网站：自动读取 EXIF/XMP 拍摄参数，解析“几月几日何处拍摄”式文件夹名，生成静态相册并托管于 GitHub Pages",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "import": "node scripts/import.mjs",
    "test": "node --test --test-isolation=none --test-reporter=spec \"tests/**/*.test.mjs\"",
    "serve": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "vendor": "node scripts/build-vendor.mjs",
    "demo": "node scripts/make-demo.mjs",
    "demo:all": "node scripts/make-demo.mjs && node scripts/import.mjs --src demo-archive --copy",
    "atlas": "node scripts/build-atlas.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:import": "node scripts/e2e-import.mjs",
    "e2e:write": "node scripts/e2e-write.mjs",
    "e2e:pickdir": "node scripts/e2e-pickdir.mjs"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "exifr": "^7.1.3"
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  }
}
